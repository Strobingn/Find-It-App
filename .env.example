# OpenAI is the primary cloud terrain-analysis provider.
# Prefer routing through your authenticated proxy so the real OpenAI key stays server-side.
OPENAI_BASE_URL=https://api.openai.com/v1/responses
OPENAI_PROXY_TOKEN=YOUR_PROXY_AUTH_TOKEN
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5.2

# Gemini is the automatic fallback provider.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.1-pro-preview

# Google Maps SDK for Android key. Restrict it to the Android package and signing certificate.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_ANDROID_KEY

# Mapbox public access token (starts with pk.) for the Mapbox terrain map tab.
# Create one at https://account.mapbox.com/access-tokens/ and restrict it to this app if you can.
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_PUBLIC_TOKEN
